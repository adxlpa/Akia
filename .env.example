# Supabase Backend Configuration
# Obtain your Project URL and Anon Key from the Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon/public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Obtain from Google Analytics: Admin -> Data Streams -> Web -> Measurement ID
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Search Console Verification Meta Tag Value
# Obtain from Google Search Console: Settings -> Ownership Verification -> HTML tag
VITE_GSC_VERIFICATION_TAG="your_gsc_verification_hash_here"

# Canonical Production URL
VITE_SITE_URL="https://akia.in"
